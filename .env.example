# Optional. Plaid credentials enable linked bank accounts and background transaction sync.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional local AI endpoint. Defaults to Ollama at http://localhost:11434 when enabled.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional OpenAI-compatible endpoint overrides Ollama when both are configured.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

PORT=3000
DATA_DIR=./data
TRUST_PROXY=0
TUNNEL_TOKEN=
